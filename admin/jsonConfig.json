{
  "type": "panel",
  "items": {
    "shellyShutters": {
      "type": "selectSendTo",
      "label": "Gefundene Shelly-Shutter",
      "help": "Lädt alle beschreibbaren Positions-Datenpunkte mit der ioBroker-Rolle level.blind aus Shelly-Instanzen. Mehrfachauswahl möglich.",
      "command": "discoverShellyShutters",
      "multiple": true,
      "manual": false,
      "noTranslation": true
    },
    "devices": {
      "type": "table",
      "label": "Beschattungsgeräte",
      "help": "Lege hier jedes Rollo, jede Jalousie und jede Markise an. Datenpunkt-IDs sind vollständige ioBroker-IDs. Open und Close senden den konfigurierten JSON-Wert. Die Positionssteuerung verwendet 0 = geschlossen und 100 = geöffnet. Kontakte werden gelesen und hier angezeigt; automatische Regeln folgen später.",
      "useCardFor": [
        "xs",
        "sm"
      ],
      "titleAttribute": "name",
      "items": [
        {
          "type": "text",
          "attr": "deviceId",
          "title": "Interne ID (stabil, z. B. wohnzimmer)",
          "default": ""
        },
        {
          "type": "text",
          "attr": "name",
          "title": "Anzeigename",
          "default": ""
        },
        {
          "type": "select",
          "attr": "deviceType",
          "title": "Gerätetyp",
          "options": [
            {
              "value": "shutter",
              "label": "Rollo"
            },
            {
              "value": "blind",
              "label": "Jalousie"
            },
            {
              "value": "awning",
              "label": "Markise"
            }
          ],
          "default": "shutter"
        },
        {
          "type": "text",
          "attr": "openId",
          "title": "Datenpunkt: Öffnen"
        },
        {
          "type": "text",
          "attr": "openValue",
          "title": "Wert zum Öffnen (JSON, Standard true)",
          "default": "true"
        },
        {
          "type": "text",
          "attr": "closeId",
          "title": "Datenpunkt: Schließen"
        },
        {
          "type": "text",
          "attr": "closeValue",
          "title": "Wert zum Schließen (JSON, Standard true)",
          "default": "true"
        },
        {
          "type": "text",
          "attr": "positionId",
          "title": "Datenpunkt: Position (optional)"
        },
        {
          "type": "number",
          "attr": "positionClosedValue",
          "title": "Positionswert für geschlossen",
          "default": 0
        },
        {
          "type": "number",
          "attr": "positionOpenValue",
          "title": "Positionswert für geöffnet",
          "default": 100
        },
        {
          "type": "text",
          "attr": "closedContactId",
          "title": "Kontakt-Datenpunkt: geschlossen (optional)"
        },
        {
          "type": "checkbox",
          "attr": "closedContactInvert",
          "title": "Kontaktwert für „geschlossen“ invertieren",
          "default": false
        },
        {
          "type": "text",
          "attr": "tiltedContactId",
          "title": "Kontakt-Datenpunkt: gekippt (optional)"
        },
        {
          "type": "checkbox",
          "attr": "tiltedContactInvert",
          "title": "Kontaktwert für „gekippt“ invertieren",
          "default": false
        }
      ]
    }
  }
}