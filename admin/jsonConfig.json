{
  "type": "panel",
  "items": {
    "sortByName": {
      "type": "sendTo",
      "label": "Gerätename",
      "title": "Nach Gerätename sortieren. Noch einmal drücken, um die Sortierrichtung umzukehren.",
      "command": "sortShadingDevices",
      "jsonData": "{\"sortBy\":\"name\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"sortState\":${JSON.stringify(data.deviceSort || {})}}",
      "useNative": true,
      "showProcess": true,
      "xs": 3,
      "sm": 3,
      "controlStyle": {
        "justifyContent": "flex-start",
        "padding": "4px 8px",
        "minWidth": 0,
        "textTransform": "none",
        "fontWeight": 600
      }
    },
    "sortByRoom": {
      "type": "sendTo",
      "label": "Raum",
      "title": "Nach Raum sortieren. Noch einmal drücken, um die Sortierrichtung umzukehren.",
      "command": "sortShadingDevices",
      "jsonData": "{\"sortBy\":\"room\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"sortState\":${JSON.stringify(data.deviceSort || {})}}",
      "useNative": true,
      "showProcess": true,
      "xs": 3,
      "sm": 3,
      "controlStyle": {
        "justifyContent": "flex-start",
        "padding": "4px 8px",
        "minWidth": 0,
        "textTransform": "none",
        "fontWeight": 600
      }
    },
    "sortBySource": {
      "type": "sendTo",
      "label": "Quelle",
      "title": "Nach Quelle sortieren. Noch einmal drücken, um die Sortierrichtung umzukehren.",
      "command": "sortShadingDevices",
      "jsonData": "{\"sortBy\":\"source\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"sortState\":${JSON.stringify(data.deviceSort || {})}}",
      "useNative": true,
      "showProcess": true,
      "xs": 3,
      "sm": 3,
      "controlStyle": {
        "justifyContent": "flex-start",
        "padding": "4px 8px",
        "minWidth": 0,
        "textTransform": "none",
        "fontWeight": 600
      }
    },
    "sortByDataSource": {
      "type": "sendTo",
      "label": "Datenquelle",
      "title": "Nach Datenquelle sortieren. Noch einmal drücken, um die Sortierrichtung umzukehren.",
      "command": "sortShadingDevices",
      "jsonData": "{\"sortBy\":\"dataSource\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"sortState\":${JSON.stringify(data.deviceSort || {})}}",
      "useNative": true,
      "showProcess": true,
      "xs": 3,
      "sm": 3,
      "controlStyle": {
        "justifyContent": "flex-start",
        "padding": "4px 8px",
        "minWidth": 0,
        "textTransform": "none",
        "fontWeight": 600
      }
    },
    "devices": {
      "type": "table",
      "help": "Die Geräteliste zeigt Gerätenamen, Raum, Quelle und Datenquelle. Technische Datenpunkt-Zuordnungen werden intern gespeichert; automatische Regeln folgen später.",
      "useCardFor": [
        "xs",
        "sm"
      ],
      "titleAttribute": "name",
      "items": [
        {
          "type": "text",
          "attr": "name",
          "title": "",
          "default": ""
        },
        {
          "type": "text",
          "attr": "room",
          "title": "",
          "default": "",
          "readOnly": true
        },
        {
          "type": "text",
          "attr": "source",
          "title": "",
          "default": "",
          "readOnly": true,
          "defaultFunc": "data.positionId && data.positionId.startsWith('alias.0.') ? 'Device Manager' : 'Direkt'"
        },
        {
          "type": "text",
          "attr": "dataSource",
          "title": "",
          "default": "",
          "readOnly": true,
          "defaultFunc": "data.positionId ? (data.positionId.startsWith('shelly.') ? 'Shelly' : data.positionId.split('.')[0]) : ''"
        }
      ]
    },
    "shadingDevice": {
      "type": "selectSendTo",
      "label": "Beschattungsgerät auswählen",
      "help": "Zeigt Shelly-Rollläden sowie Rollos und Markisen aus dem Device Manager. Verknüpfte Geräte werden bevorzugt, damit die dort zugeordneten Datenpunkte verwendet werden.",
      "command": "discoverShadingDevices",
      "multiple": false,
      "manual": false,
      "noTranslation": true,
      "doNotSave": true,
      "jsonData": "{\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"deviceSort\":${JSON.stringify(data.deviceSort || {})}}",
      "alsoDependsOn": [
        "devices",
        "deviceMappings"
      ]
    },
    "addShadingDevice": {
      "type": "sendTo",
      "label": "Ausgewähltes Gerät in die Geräteliste aufnehmen",
      "help": "Übernimmt das ausgewählte Rollo oder die Markise. Die erkannte Positionssteuerung wird intern zugeordnet.",
      "command": "addShadingDevice",
      "jsonData": "{\"key\":\"${data.shadingDevice}\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"deviceSort\":${JSON.stringify(data.deviceSort || {})}}",
      "variant": "contained",
      "showProcess": true,
      "useNative": true,
      "result": {
        "de": "Beschattungsgerät wurde in die Geräteliste aufgenommen.",
        "en": "Shading device was added to the device list."
      },
      "error": {
        "de": "Beschattungsgerät konnte nicht aufgenommen werden.",
        "en": "Could not add the shading device."
      },
      "disabled": "!data.shadingDevice"
    },
    "deviceMappings": {
      "type": "jsonEditor",
      "label": "Interne Gerätezuordnungen",
      "hidden": true,
      "default": {}
    },
    "deviceSort": {
      "type": "jsonEditor",
      "label": "Interner Sortierzustand",
      "hidden": true,
      "default": {}
    }
  }
}