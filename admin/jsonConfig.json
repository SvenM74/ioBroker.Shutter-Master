{
  "type": "tabs",
  "items": {
    "shadingDevices": {
      "type": "panel",
      "label": "Beschattungsgeräte",
      "items": {
        "devices": {
          "type": "table",
          "useCardFor": [
            "xs",
            "sm"
          ],
          "titleAttribute": "name",
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": "Gerätename",
              "default": "",
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": true
            },
            {
              "type": "text",
              "attr": "room",
              "title": "Raum",
              "default": "",
              "readOnly": true,
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": true
            },
            {
              "type": "text",
              "attr": "source",
              "title": "Quelle",
              "default": "",
              "readOnly": true,
              "defaultFunc": "data.positionId && data.positionId.startsWith('alias.0.') ? 'Device Manager' : 'Direkt'",
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": true
            },
            {
              "type": "text",
              "attr": "dataSource",
              "title": "Datenquelle",
              "default": "",
              "readOnly": true,
              "defaultFunc": "data.positionId ? (data.positionId.startsWith('shelly.') ? 'Shelly' : data.positionId.split('.')[0]) : ''",
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": true
            },
            {
              "type": "checkbox",
              "attr": "timeBased",
              "title": "Morgens/abends",
              "label": "",
              "default": false,
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": false
            },
            {
              "type": "checkbox",
              "attr": "sunPosition",
              "title": "Sonnenstand",
              "label": "",
              "default": false,
              "style": {
                "fontSize": "0.75rem"
              },
              "sort": false
            }
          ],
          "compact": true,
          "label": "Beschattungsgeräte"
        },
        "shadingDevice": {
          "type": "selectSendTo",
          "label": "Beschattungsgerät auswählen",
          "command": "discoverShadingDevices",
          "multiple": false,
          "manual": false,
          "noTranslation": true,
          "doNotSave": true,
          "jsonData": "{\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"deviceSort\":${JSON.stringify(data.deviceSort || {})}}",
          "alsoDependsOn": [
            "devices",
            "deviceMappings"
          ]
        },
        "addShadingDevice": {
          "type": "sendTo",
          "label": "Ausgewähltes Gerät in die Geräteliste aufnehmen",
          "command": "addShadingDevice",
          "jsonData": "{\"key\":\"${data.shadingDevice}\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})},\"deviceSort\":${JSON.stringify(data.deviceSort || {})}}",
          "variant": "contained",
          "showProcess": true,
          "useNative": true,
          "result": {
            "de": "Beschattungsgerät wurde in die Geräteliste aufgenommen.",
            "en": "Shading device was added to the device list."
          },
          "error": {
            "de": "Beschattungsgerät konnte nicht aufgenommen werden.",
            "en": "Could not add the shading device."
          },
          "disabled": "!data.shadingDevice"
        },
        "deviceMappings": {
          "type": "jsonEditor",
          "label": "Interne Gerätezuordnungen",
          "hidden": true,
          "default": {}
        }
      }
    },
    "morningEvening": {
      "type": "panel",
      "label": "Morgens und abends",
      "items": {
        "morningHeader": {
          "type": "header",
          "text": "Morgens",
          "size": 5,
          "xs": 12
        },
        "morningOpenTime": {
          "type": "timePicker",
          "label": "Öffnen",
          "format": "HH:mm",
          "views": [
            "hours",
            "minutes"
          ],
          "returnFormat": "HH:mm:ss",
          "xs": 6,
          "default": ""
        },
        "morningCloseTime": {
          "type": "timePicker",
          "label": "Schließen",
          "format": "HH:mm",
          "views": [
            "hours",
            "minutes"
          ],
          "returnFormat": "HH:mm:ss",
          "xs": 6,
          "default": ""
        },
        "eveningHeader": {
          "type": "header",
          "text": "Abends",
          "size": 5,
          "xs": 12,
          "newLine": true
        },
        "eveningOpenTime": {
          "type": "timePicker",
          "label": "Öffnen",
          "format": "HH:mm",
          "views": [
            "hours",
            "minutes"
          ],
          "returnFormat": "HH:mm:ss",
          "xs": 6,
          "default": ""
        },
        "eveningCloseTime": {
          "type": "timePicker",
          "label": "Schließen",
          "format": "HH:mm",
          "views": [
            "hours",
            "minutes"
          ],
          "returnFormat": "HH:mm:ss",
          "xs": 6,
          "default": ""
        }
      }
    },
    "sunPosition": {
      "type": "panel",
      "label": "Sonnenstand",
      "items": {
        "morningSunHeader": {
          "type": "header",
          "text": "Morgens",
          "size": 5,
          "xs": 12
        },
        "eveningSunHeader": {
          "type": "header",
          "text": "Abends",
          "size": 5,
          "xs": 12,
          "newLine": true
        },
        "morningOpenAzimuth": {
          "type": "number",
          "label": "Morgens: Öffnen – Azimut",
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "morningOpenElevation": {
          "type": "number",
          "label": "Morgens: Öffnen – Elevation",
          "min": -90,
          "max": 90,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "morningOpenOffsetMinutes": {
          "type": "number",
          "label": "Versatz (Minuten; − früher, + später)",
          "min": -720,
          "max": 720,
          "step": 1,
          "unit": "min",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "morningCloseAzimuth": {
          "type": "number",
          "label": "Morgens: Schließen – Azimut",
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "morningCloseElevation": {
          "type": "number",
          "label": "Morgens: Schließen – Elevation",
          "min": -90,
          "max": 90,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "morningCloseOffsetMinutes": {
          "type": "number",
          "label": "Versatz (Minuten; − früher, + später)",
          "min": -720,
          "max": 720,
          "step": 1,
          "unit": "min",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningOpenAzimuth": {
          "type": "number",
          "label": "Abends: Öffnen – Azimut",
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningOpenElevation": {
          "type": "number",
          "label": "Abends: Öffnen – Elevation",
          "min": -90,
          "max": 90,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningOpenOffsetMinutes": {
          "type": "number",
          "label": "Versatz (Minuten; − früher, + später)",
          "min": -720,
          "max": 720,
          "step": 1,
          "unit": "min",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningCloseAzimuth": {
          "type": "number",
          "label": "Abends: Schließen – Azimut",
          "min": 0,
          "max": 360,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningCloseElevation": {
          "type": "number",
          "label": "Abends: Schließen – Elevation",
          "min": -90,
          "max": 90,
          "step": 1,
          "unit": "°",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        },
        "eveningCloseOffsetMinutes": {
          "type": "number",
          "label": "Versatz (Minuten; − früher, + später)",
          "min": -720,
          "max": 720,
          "step": 1,
          "unit": "min",
          "xs": 4,
          "style": {
            "fontSize": "0.8rem"
          }
        }
      }
    }
  }
}
