{
  "type": "panel",
  "items": {
    "devices": {
      "type": "table",
      "help": "Die Geräteliste zeigt Gerätenamen, Raum, Quelle und Datenquelle. Technische Datenpunkt-Zuordnungen werden intern gespeichert; automatische Regeln folgen später.",
      "useCardFor": [
        "xs",
        "sm"
      ],
      "titleAttribute": "name",
      "items": [
        {
          "type": "text",
          "attr": "name",
          "title": "Gerätename",
          "default": "",
          "sort": true
        },
        {
          "type": "text",
          "attr": "room",
          "title": "Raum",
          "default": "",
          "readOnly": true
        },
        {
          "type": "text",
          "attr": "source",
          "title": "Quelle",
          "default": "",
          "readOnly": true,
          "defaultFunc": "data.positionId && data.positionId.startsWith('alias.0.') ? 'Device Manager' : 'Direkt'"
        },
        {
          "type": "text",
          "attr": "dataSource",
          "title": "Datenquelle",
          "default": "",
          "readOnly": true,
          "defaultFunc": "data.positionId ? (data.positionId.startsWith('shelly.') ? 'Shelly' : data.positionId.split('.')[0]) : ''"
        },
        {
          "type": "sendTo",
          "attr": "_remove",
          "title": "Gerät entfernen",
          "icon": "delete",
          "command": "removeShadingDevice",
          "jsonData": "{\"deviceId\":\"${data.deviceId}\",\"devices\":${JSON.stringify(globalData.devices || [])},\"deviceMappings\":${JSON.stringify(globalData.deviceMappings || {})}}",
          "useNative": true,
          "showProcess": false,
          "width": "110px",
          "label": "Entfernen"
        }
      ],
      "noDelete": true,
      "label": "Beschattungsgeräte"
    },
    "shadingDevice": {
      "type": "selectSendTo",
      "label": "Beschattungsgerät auswählen",
      "help": "Zeigt Shelly-Rollläden sowie Rollos und Markisen aus dem Device Manager. Verknüpfte Geräte werden bevorzugt, damit die dort zugeordneten Datenpunkte verwendet werden.",
      "command": "discoverShadingDevices",
      "multiple": false,
      "manual": false,
      "noTranslation": true,
      "doNotSave": true,
      "jsonData": "{\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})}}",
      "alsoDependsOn": [
        "devices",
        "deviceMappings"
      ]
    },
    "addShadingDevice": {
      "type": "sendTo",
      "label": "Ausgewähltes Gerät in die Geräteliste aufnehmen",
      "help": "Übernimmt das ausgewählte Rollo oder die Markise. Die erkannte Positionssteuerung wird intern zugeordnet.",
      "command": "addShadingDevice",
      "jsonData": "{\"key\":\"${data.shadingDevice}\",\"devices\":${JSON.stringify(data.devices || [])},\"deviceMappings\":${JSON.stringify(data.deviceMappings || {})}}",
      "variant": "contained",
      "showProcess": true,
      "useNative": true,
      "result": {
        "de": "Beschattungsgerät wurde in die Geräteliste aufgenommen.",
        "en": "Shading device was added to the device list."
      },
      "error": {
        "de": "Beschattungsgerät konnte nicht aufgenommen werden.",
        "en": "Could not add the shading device."
      },
      "disabled": "!data.shadingDevice"
    },
    "deviceMappings": {
      "type": "jsonEditor",
      "label": "Interne Gerätezuordnungen",
      "hidden": true,
      "default": {}
    }
  }
}